# Copy to .env and fill in values (same names as on Vercel)

AUTH_SECRET=
# ローカル専用。Vercel Dashboard では削除（誤 URL 例: www.motoo1789.vercel → CORS/500）
NUXT_PUBLIC_AUTH_ORIGIN=http://localhost:3000

# どちらのプレフィックスでも可（Nuxt 推奨は NUXT_PUBLIC_）
NUXT_PUBLIC_CONTENTFUL_SPACE_ID=
NUXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN=
NEXT_PUBLIC_CONTENTFUL_SPACE_ID=
NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN=
NEXT_PUBLIC_CONTENTFUL_ENVIROMENT=master
NEXT_PUBLIC_CONTENTFUL_CONTENT_TYPE_PROJECT=
NEXT_PUBLIC_CONTENTFUL_CONTENT_TYPE_INFORMATIONL=

# Management API (admin POST routes only)
NEXT_PUBLIC_CONTENTFUL_MANAGEMENT_API_KEY=

# Vercel Postgres（@vercel/postgres / ログイン・addUser 用。Vercel Storage からコピー）
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Newt 問い合わせフォーム / reCAPTCHA（contact ページ）
NEXT_PUBLIC_NEWT=
NEXT_PUBLIC_RECAPTCHA=
# 旧名（ローカル .env 互換）
Newt=
NEXT_PUBLIC_SITE_KEY=

# GitHub OAuth（任意）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
